{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanhu.local/schemas/appearance.schema.json",
  "title": "Wanhu Appearance Authoring V1",
  "$defs": {
    "stableId": {"type":"string","pattern":"^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "weight": {"type":"number","exclusiveMinimum":0},
    "genderList": {"type":"array","items":{"enum":["male","female"]},"uniqueItems":true},
    "lifeStageList": {"type":"array","items":{"enum":["child","teen","young-adult","adult","middle-age","elder"]},"uniqueItems":true},
    "wealthTierList": {"type":"array","items":{"enum":["poor","plain","comfortable","wealthy"]},"uniqueItems":true},
    "presentationStyleList": {"type":"array","items":{"enum":["practical","tidy","refined"]},"uniqueItems":true},
    "faceFamily": {"enum":["oval","round","long","square","broad"]},
    "faceFamilyList": {"type":"array","items":{"$ref":"#/$defs/faceFamily"},"uniqueItems":true},
    "hairVisibility": {"enum":["full","back-only","hidden"]},
    "rig": {
      "type":"object",
      "additionalProperties":false,
      "required":["centerX","topY","hairlineY","browY","eyeY","noseY","mouthY","chinY","faceWidth","jawWidth","earY","neckTopY","shoulderY"],
      "properties": {
        "centerX":{"type":"number","minimum":0,"maximum":120},
        "topY":{"type":"number","minimum":0,"maximum":120},
        "hairlineY":{"type":"number","minimum":0,"maximum":120},
        "browY":{"type":"number","minimum":0,"maximum":120},
        "eyeY":{"type":"number","minimum":0,"maximum":120},
        "noseY":{"type":"number","minimum":0,"maximum":120},
        "mouthY":{"type":"number","minimum":0,"maximum":120},
        "chinY":{"type":"number","minimum":0,"maximum":120},
        "faceWidth":{"type":"number","exclusiveMinimum":0,"maximum":80},
        "jawWidth":{"type":"number","exclusiveMinimum":0,"maximum":80},
        "earY":{"type":"number","minimum":0,"maximum":120},
        "neckTopY":{"type":"number","minimum":0,"maximum":120},
        "shoulderY":{"type":"number","minimum":0,"maximum":120}
      }
    }
  },
  "type": "object",
  "required": ["schema", "parts", "palettes"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const":"wanhu.appearance-parts.v1"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slot", "label", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": {"allOf":[{"$ref":"#/$defs/stableId"},{"pattern":"^appearance\\."}]},
          "slot": {"enum":["face","hair","brow","facial-hair","headwear","outfit"]},
          "label": {"type":"string","minLength":1},
          "weight": {"$ref":"#/$defs/weight"},
          "genders": {"$ref":"#/$defs/genderList"},
          "lifeStages": {"$ref":"#/$defs/lifeStageList"},
          "wealthTiers": {"$ref":"#/$defs/wealthTierList"},
          "presentationStyles": {"$ref":"#/$defs/presentationStyleList"},
          "assetKey": {"type":"string","minLength":1},
          "faceFamily": {"$ref":"#/$defs/faceFamily"},
          "preferredFaceFamilies": {"$ref":"#/$defs/faceFamilyList"},
          "avoidFaceFamilies": {"$ref":"#/$defs/faceFamilyList"},
          "hairVisibility": {"$ref":"#/$defs/hairVisibility"},
          "rig": {"$ref":"#/$defs/rig"}
        }
      }
    },
    "palettes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slot", "label", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": {"allOf":[{"$ref":"#/$defs/stableId"},{"pattern":"^appearance\\.palette\\."}]},
          "slot": {"enum":["skin","hair","clothing"]},
          "label": {"type":"string","minLength":1},
          "weight": {"$ref":"#/$defs/weight"},
          "genders": {"$ref":"#/$defs/genderList"},
          "lifeStages": {"$ref":"#/$defs/lifeStageList"},
          "wealthTiers": {"$ref":"#/$defs/wealthTierList"},
          "presentationStyles": {"$ref":"#/$defs/presentationStyleList"}
        }
      }
    }
  }
}
