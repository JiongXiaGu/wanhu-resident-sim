{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanhu.local/schemas/name-v2.schema.json",
  "title": "Wanhu Name Authoring V2",
  "$defs": {
    "stableId": {"type":"string","pattern":"^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "weight": {"type":"number","exclusiveMinimum":0},
    "stringList": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  },
  "oneOf": [
    {
      "type":"object","required":["schema","items"],"additionalProperties":false,
      "properties": {
        "schema":{"const":"wanhu.surnames.v2"},
        "items":{"type":"array","minItems":1,"items":{"type":"object","required":["id","text","weight"],"additionalProperties":false,"properties":{"id":{"allOf":[{"$ref":"#/$defs/stableId"},{"pattern":"^name\\.surname\\."}]},"text":{"type":"string","minLength":1},"weight":{"$ref":"#/$defs/weight"},"styles":{"$ref":"#/$defs/stringList"},"generationGroups":{"$ref":"#/$defs/stringList"}}}}
      }
    },
    {
      "type":"object","required":["schema","items"],"additionalProperties":false,
      "properties": {
        "schema":{"const":"wanhu.given-names.v2"},
        "items":{"type":"array","minItems":1,"items":{"type":"object","required":["id","text","gender","weight"],"additionalProperties":false,"properties":{"id":{"allOf":[{"$ref":"#/$defs/stableId"},{"pattern":"^name\\.given\\."}]},"text":{"type":"string","minLength":1},"gender":{"enum":["male","female","unisex"]},"weight":{"$ref":"#/$defs/weight"},"styles":{"$ref":"#/$defs/stringList"},"generationGroups":{"$ref":"#/$defs/stringList"}}}}
      }
    }
  ]
}
