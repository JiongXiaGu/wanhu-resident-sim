{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanhu.local/schemas/life-event.schema.json",
  "title": "Wanhu Resident Life Events V3",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "lifeTagId": {
      "type": "string",
      "pattern": "^lifetag\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "lifeTagList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifeTagId"
      },
      "uniqueItems": true
    },
    "structuralRequest": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "occupationId"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "changeOccupation"
            },
            "occupationId": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "moveHousehold"
            },
            "policy": {
              "enum": [
                "same-district",
                "different-district",
                "any-district"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "formMarriage"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "addChild"
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wanhu.life-events.v3"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text",
          "weight",
          "eligibility"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "memoryText": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "recordToHistory": {
            "type": "boolean"
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occupations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/stableId"
                },
                "uniqueItems": true
              },
              "occupationGroups": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/stableId"
                },
                "uniqueItems": true
              },
              "genders": {
                "type": "array",
                "items": {
                  "enum": [
                    "male",
                    "female"
                  ]
                },
                "uniqueItems": true
              },
              "minAge": {
                "type": "integer",
                "minimum": 0
              },
              "maxAge": {
                "type": "integer",
                "minimum": 0
              },
              "minChildren": {
                "type": "integer",
                "minimum": 0
              },
              "requireSpouse": {
                "type": "boolean"
              },
              "requiredTags": {
                "$ref": "#/$defs/lifeTagList"
              },
              "forbiddenTags": {
                "$ref": "#/$defs/lifeTagList"
              }
            }
          },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "addTags": {
                "$ref": "#/$defs/lifeTagList"
              },
              "removeTags": {
                "$ref": "#/$defs/lifeTagList"
              },
              "structuralRequests": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/structuralRequest"
                },
                "maxItems": 4
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "type",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "city",
                  "family",
                  "work",
                  "weather",
                  "personal"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
