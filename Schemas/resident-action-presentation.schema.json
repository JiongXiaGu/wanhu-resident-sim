{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanhu.local/schemas/resident-action-presentation.schema.json",
  "title": "Wanhu Resident Action Presentations V1",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wanhu.resident-action-presentations.v1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/presentation"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^resident-action\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "variant": {
      "type": "object",
      "required": [
        "text",
        "weight"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": [
        "id",
        "currentText",
        "cooldownDays",
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "currentText": {
          "type": "string",
          "minLength": 1
        },
        "cooldownDays": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    }
  }
}
