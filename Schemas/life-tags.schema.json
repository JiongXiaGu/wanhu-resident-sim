{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanhu.local/schemas/life-tags.schema.json",
  "title": "Wanhu LifeTag Registry V1",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "wanhu.life-tags.v1"},
    "items": {"type":"array","minItems":1,"items":{"type":"object","required":["id","label","category"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^lifetag\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"},"label":{"type":"string","minLength":1},"category":{"type":"string","minLength":1},"description":{"type":"string","minLength":1}}}}
  },
  "additionalProperties": false
}
