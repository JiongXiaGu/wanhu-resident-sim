{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanhu.local/schemas/resident-snapshot.schema.json",
  "title": "Wanhu Resident Snapshot V6",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "profile": {
      "type": "object",
      "required": [
        "temperamentId",
        "lifeFocusId",
        "presentationStyleId"
      ],
      "additionalProperties": false,
      "properties": {
        "temperamentId": {
          "$ref": "#/$defs/stableId"
        },
        "lifeFocusId": {
          "$ref": "#/$defs/stableId"
        },
        "presentationStyleId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "portrait": {
      "type": "object",
      "required": [
        "faceFamilyId",
        "hairStyleId",
        "outfitStyleId",
        "skinPaletteId",
        "baseHairColorId"
      ],
      "additionalProperties": false,
      "properties": {
        "faceFamilyId": {
          "type": "string"
        },
        "hairStyleId": {
          "type": "string"
        },
        "outfitStyleId": {
          "type": "string"
        },
        "skinPaletteId": {
          "type": "string"
        },
        "baseHairColorId": {
          "type": "string"
        }
      }
    },
    "currentAction": {
      "type": "object",
      "required": [
        "actionId",
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "$ref": "#/$defs/stableId"
        },
        "targetResidentId": {
          "type": "integer"
        },
        "placeId": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "moving",
            "executing"
          ]
        }
      }
    },
    "recentAction": {
      "type": "object",
      "required": [
        "id",
        "day",
        "actionId",
        "variantIndex"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "day": {
          "type": "integer"
        },
        "actionId": {
          "$ref": "#/$defs/stableId"
        },
        "variantIndex": {
          "type": "integer",
          "minimum": 0
        },
        "targetResidentId": {
          "type": "integer"
        },
        "placeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recentLifeEvent": {
      "type": "object",
      "required": [
        "id",
        "day",
        "eventId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "day": {
          "type": "integer"
        },
        "eventId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "lifeChapter": {
      "type": "object",
      "required": [
        "id",
        "day",
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "day": {
          "type": "integer"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceEventId": {
          "$ref": "#/$defs/stableId"
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schema",
    "citySeed",
    "currentDay",
    "residents",
    "households"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wanhu.resident-snapshot.v6"
    },
    "citySeed": {
      "type": "integer"
    },
    "currentDay": {
      "type": "integer"
    },
    "residents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "seed",
          "displayName",
          "surname",
          "surnameId",
          "givenNameId",
          "birthDay",
          "gender",
          "portrait",
          "profile",
          "districtId",
          "occupationId",
          "householdId",
          "fatherId",
          "motherId",
          "spouseId",
          "childCount",
          "nextUpdateDay",
          "lifeStage",
          "stateBits",
          "lifeTags",
          "currentAction",
          "recentActions",
          "recentLifeEvents",
          "lifeChapters"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "seed": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "surnameId": {
            "$ref": "#/$defs/stableId"
          },
          "givenNameId": {
            "$ref": "#/$defs/stableId"
          },
          "birthDay": {
            "type": "integer"
          },
          "gender": {
            "enum": [
              "male",
              "female"
            ]
          },
          "portrait": {
            "$ref": "#/$defs/portrait"
          },
          "profile": {
            "$ref": "#/$defs/profile"
          },
          "districtId": {
            "type": "string"
          },
          "occupationId": {
            "$ref": "#/$defs/stableId"
          },
          "workplaceId": {
            "type": "integer"
          },
          "employmentStartDay": {
            "type": "integer"
          },
          "householdId": {
            "type": "integer"
          },
          "fatherId": {
            "type": "integer"
          },
          "motherId": {
            "type": "integer"
          },
          "spouseId": {
            "type": "integer"
          },
          "childCount": {
            "type": "integer",
            "minimum": 0
          },
          "nextUpdateDay": {
            "type": "integer"
          },
          "lifeStage": {
            "type": "string"
          },
          "stateBits": {
            "type": "integer"
          },
          "lifeTags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stableId"
            },
            "uniqueItems": true
          },
          "currentAction": {
            "$ref": "#/$defs/currentAction"
          },
          "recentActions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/recentAction"
            }
          },
          "recentLifeEvents": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/recentLifeEvent"
            }
          },
          "lifeChapters": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/lifeChapter"
            }
          }
        }
      }
    },
    "households": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "homeId",
          "districtId",
          "memberIds",
          "wealthTier"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "homeId": {
            "type": "integer"
          },
          "districtId": {
            "type": "string"
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "wealthTier": {
            "enum": [
              "poor",
              "plain",
              "comfortable",
              "wealthy"
            ]
          }
        }
      }
    }
  }
}
