    {
      "id": "lifeevent.drainage-access",
      "title": "街口排水工程",
      "text": "铺门前挖排水沟时，客人只能绕路进来。几日后工人铺了临时木板，等围栏撤走，门前不再积水，铺子的生意也慢慢恢复了。",
      "weight": 6,
      "eligibility": {
        "occupations": [
          "occupation.cloth-worker",
          "occupation.carpenter",
          "occupation.account-clerk",
          "occupation.vendor"
        ],
        "minAge": 18
      },
      "source": {
        "type": "city",
        "label": "北市坊排水工程"
      }
    },
    {
      "id": "lifeevent.new-bridge-route",
      "title": "新桥改变了来回的路",
      "text": "新桥通行后，我先走了一趟，过河不用再等渡船。几趟活改走这边以后，来回省下不少时辰，常走的客人也渐渐换了路线。",
      "weight": 5,
      "eligibility": {
        "occupations": [
          "occupation.courier",
          "occupation.lock-keeper",
          "occupation.vendor"
        ],
        "minAge": 18
      },
      "source": {
        "type": "city",
        "label": "河中新桥"
      }
    },
    {
      "id": "lifeevent.craft-busy-orders",
      "title": "最近的活忽然多了",
      "text": "原本排好的活还没做完，又一连来了几笔新活。我把急活和慢活重新排过，推掉实在赶不及的，忙了一阵，总算把最后一件赶活交了出去。",
      "weight": 7,
      "eligibility": {
        "occupations": [
          "occupation.carpenter",
          "occupation.potter",
          "occupation.cloth-worker",
          "occupation.apprentice"
        ],
        "minAge": 15
      },
      "source": {
        "type": "work",
        "label": "近来订单增多"
      }
    },
    {
      "id": "lifeevent.market-opening",
      "title": "新菜市开张以后",
      "text": "城中新菜市开张后，街上忽然多了许多生面孔。我这边也来了不少新客，最热闹的几日过去以后，仍有几个人会特意绕来找我。",
      "weight": 5,
      "eligibility": {
        "occupations": [
          "occupation.vendor",
          "occupation.cloth-worker",
          "occupation.account-clerk"
        ],
        "minAge": 18
      },
      "source": {
        "type": "city",
        "label": "城中新菜市"
      }
    },
    {
      "id": "lifeevent.service-draft",
      "title": "服役结束回家",
      "text": "名册轮到我去城北修官道，我把家里的事交代好便跟队出发。十几日里天天搬石填土，回城时鞋底都磨薄了，第二天又回去做原来的活。",
      "weight": 3,
      "recordToHistory": true,
      "memoryText": "那年名册上轮到了我，我跟着一队人去城北修官道。天一亮就点名搬石、填土，肩背酸得晚上翻身都费劲。十几日后回城，鞋底已经磨薄，家里的活还原样等着我。歇了一夜，第二天我又照常出门做事。",
      "eligibility": {
        "occupations": [
          "occupation.carpenter",
          "occupation.potter",
          "occupation.cloth-worker",
          "occupation.account-clerk",
          "occupation.physician",
          "occupation.vendor",
          "occupation.farmer",
          "occupation.courier"
        ],
        "genders": [
          "male"
        ],
        "minAge": 18,
        "maxAge": 55,
        "forbiddenTags": [
          "lifetag.served-military"
        ]
      },
      "effects": {
        "addTags": [
          "lifetag.served-military"
        ]
      },
      "source": {
        "type": "city",
        "label": "城北官道修缮"
      }
    },
    {
      "id": "lifeevent.old-service-companion",
      "title": "旧同伍进城了",
      "text": "门口来了个多年没见的熟面孔，我听他提起当年修官道那队人才认出来。我们坐着说了半日旧事，送他出城时约好以后有机会再见。",
      "weight": 4,
      "eligibility": {
        "genders": [
          "male"
        ],
        "minAge": 26,
        "maxAge": 72,
        "requiredTags": [
          "lifetag.served-military"
        ]
      },
      "source": {
        "type": "personal",
        "label": "旧日同伍"
      }
    },
    {
      "id": "lifeevent.marriage-introduction",
      "title": "有人来给家里说亲",
      "text": "姨母今日来问我的意思，说城南有户人家想先见一面。我没有立刻答应亲事，只说可以找个空闲时候去茶铺坐坐。",
      "weight": 5,
      "eligibility": {
        "minAge": 20,
        "maxAge": 45,
        "requireSpouse": false,
        "forbiddenTags": [
          "lifetag.courtship-open",
          "lifetag.betrothed",
          "lifetag.newly-married"
        ]
      },
      "effects": {
        "addTags": [
          "lifetag.courtship-open"
        ]
      },
      "source": {
        "type": "family",
        "label": "亲友牵线"
      }
    },
    {
      "id": "lifeevent.marriage-agreement",
      "title": "两家把亲事谈妥了",
      "text": "这几回见面，我们把各自的营生和家里情况都说清楚了。今日两边长辈坐下来把日子和安排谈妥，我也点了头，婚事算正式定下。",
      "weight": 5,
      "eligibility": {
        "minAge": 20,
        "maxAge": 45,
        "requireSpouse": false,
        "requiredTags": [
          "lifetag.courtship-open"
        ]
      },
      "effects": {
        "removeTags": [
          "lifetag.courtship-open"
        ],
        "addTags": [
          "lifetag.betrothed"
        ]
      },
      "source": {
        "type": "family",
        "label": "两家商议婚事"
      }
    },
    {
      "id": "lifeevent.marriage-completion",
      "title": "今日成了婚",
      "text": "两边都点了头，今日把婚事办了。亲友来帮着搬了几样东西，忙到天黑才散，屋里从今晚起多了一个一起过日子的人。",
      "weight": 5,
      "recordToHistory": true,
      "memoryText": "那阵子亲友替我牵了线，我们在茶铺见过几回，把各自的营生和家里情况都说清楚。两家谈妥以后选了日子，成婚那天亲友帮着搬东西、收拾屋子，一直忙到天黑。人散以后再看屋里，才真觉得往后的日子要两个人一起过了。",
      "eligibility": {
        "minAge": 20,
        "maxAge": 45,
        "requireSpouse": false,
        "requiredTags": [
          "lifetag.betrothed"
        ]
      },
      "effects": {
        "removeTags": [
          "lifetag.betrothed"
        ],
        "addTags": [
          "lifetag.newly-married"
        ],
        "structuralRequests": [
          {
            "type": "formMarriage"
          }
        ]
      },
      "source": {
        "type": "family",
        "label": "成婚"
      }
    },
    {
      "id": "lifeevent.newlywed-settling",
      "title": "两个人一起过日子以后",
      "text": "成婚后屋里的碗筷、衣物和做活用的东西都得重新找地方。过了些日子，我们也慢慢分清谁顺手买菜、谁记得添灯油，许多小事已经不用特意商量。",
      "weight": 7,
      "eligibility": {
        "minAge": 20,
        "maxAge": 50,
        "requireSpouse": true,
        "requiredTags": [
          "lifetag.newly-married"
        ]
      },
      "effects": {
        "removeTags": [
          "lifetag.newly-married"
        ]
      },
      "source": {
        "type": "family",
        "label": "新婚后的日常"
      }
    },
    {
      "id": "lifeevent.child-schooling",
      "title": "孩子到了该认字的年纪",
      "text": "孩子到了爱问招牌上字的年纪，我和家里商量后把他送进附近私塾。先生领进去时他还回头看，过些日子回家路上，已经能念出几处常见的招牌。",
      "weight": 4,
      "recordToHistory": true,
      "memoryText": "孩子那阵子总爱盯着牌匾上的字，我便去问附近哪家私塾合适。送去那天，他走进门前还回头看了我好几次，先生领进去以后，我反倒在门外多站了一会儿。过些日子回家路上，他忽然念出一家铺子的招牌，只认得几个字，也高兴了一路。",
      "eligibility": {
        "minAge": 25,
        "maxAge": 58,
        "minChildren": 1,
        "forbiddenTags": [
          "lifetag.child-started-school"
        ]
      },
      "effects": {
        "addTags": [
          "lifetag.child-started-school"
        ]
      },
      "source": {
        "type": "family",
        "label": "家里的孩子"
      }
    },
    {
      "id": "lifeevent.rain-delay",
      "title": "这阵雨耽误了不少活",
      "text": "这阵雨从早到晚下个不停，许多活只能先搁着。我趁着人在屋里把能收拾的先处理好，天气转晴后又连赶几日，总算把最急的活补了回来。",
      "weight": 4,
      "eligibility": {
        "occupations": [
          "occupation.farmer",
          "occupation.courier",
          "occupation.carpenter",
          "occupation.potter"
        ],
        "minAge": 18
      },
      "source": {
        "type": "weather",
        "label": "连日秋雨"
      }
    },
    {
      "id": "lifeevent.apprentice-first-task",
      "title": "第一次让我独自做一件活",
      "text": "师傅第一次把一件小活完整交给我，只说尺寸，让我自己做。我第一遍做得不齐，拆掉重来，交活时他没再替我改，只说下次可以再快些。",
      "weight": 8,
      "recordToHistory": true,
      "memoryText": "师傅第一次把一件小活完整交给我，只说了尺寸，剩下的让我自己想办法。我第一遍做得不够齐，只好拆掉重来。交活时师傅翻看了几遍，没有再替我动手，只说下次可以再快些。那是我第一次觉得，手里的活真是自己做完的。",
      "eligibility": {
        "occupations": [
          "occupation.apprentice"
        ],
        "minAge": 13,
        "maxAge": 25,
        "forbiddenTags": [
          "lifetag.first-independent-task"
