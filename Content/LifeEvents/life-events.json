        ],
        "structuralRequests": [
          {
            "type": "formMarriage"
          }
        ]
      },
      "source": {
        "type": "family",
        "label": "成婚"
      }
    },
    {
      "id": "lifeevent.newlywed-settling",
      "title": "两个人一起过日子以后",
      "text": "成婚后屋里的碗筷、衣物和做活用的东西都得重新找地方。过了些日子，我们也慢慢分清谁顺手买菜、谁记得添灯油，许多小事已经不用特意商量。",
      "weight": 7,
      "eligibility": {
        "minAge": 20,
        "maxAge": 50,
        "requireSpouse": true,
        "requiredTags": [
          "lifetag.newly-married"
        ]
      },
      "effects": {
        "removeTags": [
          "lifetag.newly-married"
        ]
      },
      "source": {
        "type": "family",
        "label": "新婚后的日常"
      }
    },
    {
      "id": "lifeevent.child-schooling",
      "title": "孩子到了该认字的年纪",
      "text": "孩子到了爱问招牌上字的年纪，我和家里商量后把他送进附近私塾。先生领进去时他还回头看，过些日子回家路上，已经能念出几处常见的招牌。",
      "weight": 4,
      "recordToHistory": true,
      "memoryText": "孩子那阵子总爱盯着牌匾上的字，我便去问附近哪家私塾合适。送去那天，他走进门前还回头看了我好几次，先生领进去以后，我反倒在门外多站了一会儿。过些日子回家路上，他忽然念出一家铺子的招牌，只认得几个字，也高兴了一路。",
      "eligibility": {
        "minAge": 25,
        "maxAge": 58,
        "minChildren": 1,
        "forbiddenTags": [
          "lifetag.child-started-school"
        ]
      },
      "effects": {
        "addTags": [
          "lifetag.child-started-school"
        ]
      },
      "source": {
        "type": "family",
        "label": "家里的孩子"
      }
    },
    {
      "id": "lifeevent.rain-delay",
      "title": "这阵雨耽误了不少活",
      "text": "这阵雨从早到晚下个不停，许多活只能先搁着。我趁着人在屋里把能收拾的先处理好，天气转晴后又连赶几日，总算把最急的活补了回来。",
      "weight": 4,
      "eligibility": {
        "occupations": [
          "occupation.farmer",
          "occupation.courier",
          "occupation.carpenter",
          "occupation.potter"
        ],
        "minAge": 18
      },
      "source": {
        "type": "weather",
        "label": "连日秋雨"
      }
    },
    {
      "id": "lifeevent.apprentice-first-task",
      "title": "第一次让我独自做一件活",
      "text": "师傅第一次把一件小活完整交给我，只说尺寸，让我自己做。我第一遍做得不齐，拆掉重来，交活时他没再替我改，只说下次可以再快些。",
      "weight": 8,
      "recordToHistory": true,
      "memoryText": "师傅第一次把一件小活完整交给我，只说了尺寸，剩下的让我自己想办法。我第一遍做得不够齐，只好拆掉重来。交活时师傅翻看了几遍，没有再替我动手，只说下次可以再快些。那是我第一次觉得，手里的活真是自己做完的。",
      "eligibility": {
        "occupations": [
          "occupation.apprentice"
        ],
        "minAge": 13,
        "maxAge": 25,
        "forbiddenTags": [
          "lifetag.first-independent-task"
        ]
      },
      "effects": {
        "addTags": [
