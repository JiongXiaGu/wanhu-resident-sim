        ]
      },
      "source": {
        "type": "work",
        "label": "师傅交来的活"
      }
    },
    {
      "id": "lifeevent.student-errand",
      "title": "第一次独自替家里办事",
      "text": "家里第一次让我一个人去东市买东西，只给了钱和一张小纸条。回来的时候我绕错了一条巷子，好在东西和余钱都没丢，第二回再去已经认得路了。",
      "weight": 7,
      "recordToHistory": true,
      "memoryText": "家里第一次让我一个人去东市买东西，只给了钱和一张小纸条。回来的时候我绕错了一条巷子，走了好一阵才认出熟悉的街口，好在东西和余钱都没有丢。再去东市时，家里没再反复叮嘱，我自己已经认得该从哪条路回来。",
      "eligibility": {
        "occupations": [
          "occupation.student"
        ],
        "minAge": 10,
        "maxAge": 18,
        "forbiddenTags": [
          "lifetag.first-family-errand"
